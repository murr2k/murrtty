// murrtty's resources: the manifest, the icon and the version strings
// Explorer shows. Ghostty's own ghostty.rc stays as upstream has it.

// LANG_NEUTRAL(0), SUBLANG_NEUTRAL(0)
LANGUAGE 0, 0

#define RT_MANIFEST 1
RT_MANIFEST 24 "murrtty.manifest"

#define ID_ICON_MURRTTY 1
ID_ICON_MURRTTY ICON "murrtty.ico"

// The build passes its version (GhosttyExe.zig): murrtty's is Ghostty's,
// as +version says.
#ifndef MURRTTY_VERSION
#define MURRTTY_VERSION 0,0,0,0
#define MURRTTY_VERSION_STRING "0.0.0"
#endif

// ID 1, as Windows looks it up: without winver.h, VS_VERSION_INFO would be
// a resource *name*, which Explorer never finds (upstream's ghostty.rc has
// that problem).
1 VERSIONINFO
FILEVERSION     MURRTTY_VERSION
PRODUCTVERSION  MURRTTY_VERSION
FILEFLAGSMASK   0x3f
FILEFLAGS       0
FILEOS          0x40004
FILETYPE        0x1
FILESUBTYPE     0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
        VALUE "FileDescription",  "murrtty terminal"
        VALUE "FileVersion",      MURRTTY_VERSION_STRING
        VALUE "LegalCopyright",   "MIT License. Based on Ghostty by Mitchell Hashimoto and the Ghostty contributors."
        VALUE "OriginalFilename", "murrtty.exe"
        VALUE "ProductName",      "murrtty"
        VALUE "ProductVersion",   MURRTTY_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409,1200
    END
END
