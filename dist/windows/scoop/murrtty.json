        }
    },
    "bin": "bin\\murrtty.exe",
    "shortcuts": [
        [
            "bin\\murrtty.exe",
            "murrtty"
        ]
    ],
    "checkver": {
        "url": "https://api.github.com/repos/murr2k/murrtty/releases",
