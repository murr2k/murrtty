            },
            "arm64": {
                "url": "https://github.com/murr2k/murrtty/releases/download/murrtty-v$version/murrtty-$version-windows-aarch64.zip",
                "extract_dir": "murrtty-$version-windows-aarch64"
            }
        },
        "hash": {
            "url": "https://github.com/murr2k/murrtty/releases/download/murrtty-v$version/SHA256SUMS.txt"
        }
    }
