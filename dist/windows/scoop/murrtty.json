            "hash": "647e9a397ebf09f0ec6b70e35fb68dd61e36e566a493d2a3113984d2d12251c2",
            "extract_dir": "murrtty-0.2.0-windows-x86_64"
        },
        "arm64": {
            "url": "https://github.com/murr2k/murrtty/releases/download/murrtty-v0.2.0/murrtty-0.2.0-windows-aarch64.zip",
